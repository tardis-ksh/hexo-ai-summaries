{
  "name": "hexo-ai-summaries",
  "version": "1.1.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "prepare": "husky",
    "format": "prettier --write 'src/**/*.{ts,js,json,md}'",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "files": [
    "dist/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json",
    "templates"
  ],
  "repository": {
    "type": "git"
  },
  "keywords": [
    "hexo",
    "AI",
    "summary",
    "plugin"
  ],
  "authors": [
    "tardis <kshao666@gmail.com>"
  ],
  "license": "MIT",
  "description": "AI generates article summaries with support for custom templates",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^26.1.2",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml}": "prettier --write"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "handlebars": "^4.7.9",
    "hexo": "^8.1.2",
    "lodash.merge": "^4.6.2"
  },
  "packageManager": "pnpm@11.18.0"
}
