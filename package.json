{
  "name": "hexo-ai-summaries",
  "version": "1.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "prepare": "husky",
    "format": "prettier --write 'src/**/*.{ts,js,json,md}'",
    "lint": "eslint"
  },
  "files": [
    "dist/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json",
    "templates"
  ],
  "repository": {
    "type": "git"
  },
  "keywords": [
    "hexo",
    "AI",
    "summary",
    "plugin"
  ],
  "authors": [
    "tardis <kshao666@gmail.com>"
  ],
  "license": "MIT",
  "description": "AI generates article summaries with support for custom templates",
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.24.0",
    "@types/eslint__js": "^9.14.0",
    "@types/hexo": "^7.0.0",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^22.14.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  },
  "lint-staged": {
    "src/*.{ts,js,json,md}": [
      "pnpm run format",
      "pnpm run lint"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "handlebars": "^4.7.8",
    "hexo": "^7.3.0",
    "lodash.merge": "^4.6.2"
  },
  "packageManager": "pnpm@10.8.0"
}
